# Database (SQLite)
DATABASE_URL="file:./dev.db"

# Server
PORT=3001
CORS_ORIGIN=http://localhost:5173

# Rate limits (per IP / 15 min). Nonce is separate so browsing /me won't burn verify budget.
# AUTH_RATE_LIMIT_MAX=30
# NONCE_RATE_LIMIT_MAX=40

# JWT (env.ts uses JWT_SECRET / JWT_EXPIRES_IN, or falls back to JWT_ACCESS_*)
JWT_SECRET=your-secret-change-in-production
JWT_EXPIRES_IN=15m

# OpenAI (for AI coach)
OPENAI_API_KEY=sk-your-openai-api-key

# Bank link — leave empty for demo institution picker; set both for Plaid sandbox link tokens
# PLAID_CLIENT_ID=
# PLAID_SECRET=
# PLAID_ENV=sandbox

# KYC — leave false so an admin reviews submissions. Set true only for a local demo.
KYC_AUTO_APPROVE=false

# chain — simulation is fine for local; live needs hardhat node + deploy
BLOCKCHAIN_MODE=simulation
BLOCKCHAIN_RPC_URL=http://127.0.0.1:8545
BLOCKCHAIN_CHAIN_ID=31337
# BLOCKCHAIN_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
# LOAN_CONTRACT_ADDRESS=
# ATTESTATION_CONTRACT_ADDRESS=
