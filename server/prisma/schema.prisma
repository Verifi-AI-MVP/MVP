generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model AppMeta {
  key   String @id
  value String

  @@map("_app_meta")
}

model User {
  id             String    @id @default(uuid())
  walletAddress  String?   @unique @map("wallet_address")
  email          String?   @unique
  passwordHash   String?   @map("password_hash")
  firstName      String?   @map("first_name")
  lastName       String?   @map("last_name")
  role           String    @default("user")
  isActive       Boolean   @default(true) @map("is_active")
  kycStatus      String    @default("unverified") @map("kyc_status")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  accounts       Account[]
  budgets        Budget[]
  loans          Loan[]
  savingsGoals   SavingsGoal[]
  kycSubmissions KycSubmission[]
  coachMessages  CoachMessage[]
}

model SavingsGoal {
  id            String    @id @default(uuid())
  userId        String    @map("user_id")
  name          String
  /// Integer cents
  targetAmount  Int       @map("target_amount")
  /// Integer cents
  currentAmount Int       @default(0) @map("current_amount")
  targetDate    DateTime? @map("target_date")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("savings_goals")
}

model KycSubmission {
  id             String    @id @default(uuid())
  userId         String    @map("user_id")
  fullName       String    @map("full_name")
  dateOfBirth    DateTime  @map("date_of_birth")
  country        String
  documentType   String    @map("document_type")
  documentLast4  String?   @map("document_last4")
  status         String    @default("pending")
  reviewNotes    String?   @map("review_notes")
  submittedAt    DateTime  @default(now()) @map("submitted_at")
  reviewedAt     DateTime? @map("reviewed_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@map("kyc_submissions")
}

model CoachMessage {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  role      String
  content   String
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("coach_messages")
}

model Account {
  id              String   @id @default(uuid())
  userId          String   @map("user_id")
  institutionName String   @map("institution_name")
  accountName     String?  @map("account_name")
  accountType     String?  @map("account_type")
  mask            String?
  /// Integer cents
  currentBalance  Int      @default(0) @map("current_balance")
  isActive        Boolean  @default(true) @map("is_active")
  provider        String   @default("demo")
  externalItemId  String?  @map("external_item_id")
  linkStatus      String   @default("linked") @map("link_status")
  linkedAt        DateTime @default(now()) @map("linked_at")

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@index([userId])
}

model Transaction {
  id          String   @id @default(uuid())
  accountId   String   @map("account_id")
  /// Integer cents. Negative values are debits.
  amount      Int      @default(0)
  date        DateTime
  name        String?
  merchantName String?  @map("merchant_name")
  category    String?
  subcategory String?
  notes       String?
  createdAt   DateTime @default(now()) @map("created_at")

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId])
  @@index([date])
  @@index([category])
}

model Budget {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  name      String
  category  String
  /// Integer cents
  amount    Int      @default(0)
  period    String   @default("monthly")
  startDate DateTime @map("start_date")
  endDate   DateTime? @map("end_date")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model CategorizationFeedback {
  id              String   @id @default(uuid())
  userId          String   @map("user_id")
  transactionId   String?  @map("transaction_id")
  merchantName    String   @map("merchant_name")
  /// Integer cents
  amount          Int      @default(0)
  description     String?
  originalCategory String? @map("original_category")
  userCategory    String   @map("user_category")
  userSubcategory String?  @map("user_subcategory")
  createdAt       DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([transactionId])
  @@index([merchantName])
}

model FraudSignal {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  signalType  String   @map("signal_type")
  severity    String
  description String?
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([userId])
}

model LoanEligibilityResult {
  id              String   @id @default(uuid())
  userId          String   @map("user_id")
  riskScore       Int      @map("risk_score")
  decision        String
  reasonCodes     String   @map("reason_codes")
  factors         String
  /// Integer cents
  recommendedLimit Int?     @map("recommended_limit")
  modelVersion    String   @map("model_version")
  // chain fields (filled when we write to the contract)
  chainId              Int?     @map("chain_id")
  attestationContract  String?  @map("attestation_contract")
  attestationId        String?  @map("attestation_id")
  attestationTxHash    String?  @map("attestation_tx_hash")
  createdAt       DateTime @default(now()) @map("created_at")

  @@index([userId])
}

model AuditLog {
  id            String   @id @default(uuid())
  userId        String?  @map("user_id")
  action        String
  resourceType  String?  @map("resource_type")
  resourceId    String?  @map("resource_id")
  details       String?
  ipAddress     String?  @map("ip_address")
  createdAt     DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([createdAt])
}

model Loan {
  id              String   @id @default(uuid())
  userId          String   @map("user_id")
  /// Integer cents
  amount          Int      @default(0)
  interestRatePct Float    @map("interest_rate_pct")
  termMonths      Int      @map("term_months")
  /// Integer cents
  monthlyPayment  Int      @map("monthly_payment")
  status          String   @default("pending")
  appliedAt       DateTime @default(now()) @map("applied_at")
  approvedAt      DateTime? @map("approved_at")
  disbursedAt     DateTime? @map("disbursed_at")
  // filled after createLoan / status updates
  chainId           Int?     @map("chain_id")
  contractAddress   String?  @map("contract_address")
  onChainLoanId     String?  @map("on_chain_loan_id")
  createTxHash      String?  @map("create_tx_hash")
  statusTxHash      String?  @map("status_tx_hash")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}
